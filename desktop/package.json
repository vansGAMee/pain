{
  "name": "pain-desktop",
  "version": "1.8.8",
  "description": "Pain — Minimalist Audio Player & Sync Companion for Windows & Linux",
  "main": "src/main.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "web": "node src/server.js",
    "build:win": "electron-builder --win nsis zip --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "package:exe": "npx pkg . --target node18-win-x64 --output dist/Pain.exe && python3 ../tools/patch_windows_exe.py dist/Pain.exe",
    "test": "node --test test/*.test.js",
    "pulseflow:setup": "node tools/setup-pulseflow.cjs"
  },
  "build": {
    "appId": "dev.pain.desktop",
    "productName": "PAIN",
    "executableName": "pain",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "tools/setup-pulseflow.cjs",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "directories": {
      "output": "dist/native"
    },
    "linux": {
      "icon": "assets/app-icon.png",
      "category": "AudioVideo",
      "artifactName": "Pain-v${version}-Linux.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "pain"
        }
      }
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "artifactName": "Pain-v${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Pain-v${version}-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vansGAMee",
        "repo": "pain"
      }
    ],
    "asarUnpack": [
      "src/pulseflow/**/*",
      "src/vendor/pulseflow/**/*",
      "src/personal/**/*"
    ],
    "releaseInfo": {
      "releaseNotes": "- ПК: поиск караоке учитывает язык версии (eng / English Version и другие), проверяет язык найденных слов и сохраняет различия ремиксов и концертных записей.\n- ПК: исправлен запуск треков после изменения ID файла на телефоне. Восстановление принимает только однозначное совпадение записи.\n- ПК: видна загрузка трека; её можно отменить. Ошибка файла или подключения теперь объясняется в интерфейсе.\n- ПК: повторная попытка восстанавливает повреждённый кэш через тот же проверяемый путь. Ручные тексты, библиотека и история сохраняются."
    }
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "keywords": [
    "audio",
    "player",
    "minimalist",
    "pain",
    "sync",
    "windows"
  ],
  "author": "Ivan",
  "license": "ISC",
  "overrides": {
    "trigram-utils": {
      "trim": "1.0.1"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "extract-zip": "2.0.1",
    "franc-min": "5.0.0",
    "htmlparser2": "10.0.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
