{
  "name": "pain-desktop",
  "version": "1.4.7",
  "description": "Pain \u2014 Minimalist Audio Player & Sync Companion for Windows & Linux",
  "main": "src/main.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "electron": "electron .",
    "web": "node src/server.js",
    "build:win": "electron-builder --win",
    "package:exe": "pkg . --target node18-win-x64 --output dist/Pain.exe",
    "test": "node --test test/*.test.js"
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "keywords": [
    "audio",
    "player",
    "minimalist",
    "pain",
    "sync",
    "windows"
  ],
  "author": "Ivan",
  "license": "ISC"
}
