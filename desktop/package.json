{
  "name": "pain-desktop",
  "version": "1.8.2",
  "description": "Pain \u2014 Minimalist Audio Player & Sync Companion for Windows & Linux",
  "main": "src/main.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "web": "node src/server.js",
    "build:win": "electron-builder --win nsis zip --publish never",
    "build:linux": "electron-builder --linux AppImage tar.gz --publish never",
    "package:exe": "npx pkg . --target node18-win-x64 --output dist/Pain.exe && python3 ../tools/patch_windows_exe.py dist/Pain.exe",
    "test": "node --test test/*.test.js",
    "pulseflow:setup": "node tools/setup-pulseflow.cjs"
  },
  "build": {
    "appId": "dev.pain.desktop",
    "productName": "PAIN",
    "executableName": "pain",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "tools/setup-pulseflow.cjs"
    ],
    "directories": {
      "output": "dist/native"
    },
    "linux": {
      "icon": "assets/app-icon.png",
      "category": "AudioVideo",
      "artifactName": "Pain-v${version}-Linux.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "pain"
        }
      }
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "artifactName": "Pain-v${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Pain-v${version}-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vansGAMee",
        "repo": "pain"
      }
    ],
    "asarUnpack": [
      "src/pulseflow/**/*",
      "src/vendor/pulseflow/**/*"
    ]
  },
  "pkg": {
    "assets": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "keywords": [
    "audio",
    "player",
    "minimalist",
    "pain",
    "sync",
    "windows"
  ],
  "author": "Ivan",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
