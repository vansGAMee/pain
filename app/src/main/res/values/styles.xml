<resources>
 <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#454A3F</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:statusBarColor">#EFEDE6</item><item name="android:navigationBarColor">#EFEDE6</item>
  <item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">#EFEDE6</item>
 </style>
<style name="AppTheme" parent="BaseAppTheme"/>
<style name="DarkAppTheme" parent="android:style/Theme.Material.NoActionBar">
 <item name="android:fontFamily">sans</item><item name="android:colorAccent">#CACBC1</item>
 <item name="android:windowBackground">#292928</item><item name="android:statusBarColor">#292928</item><item name="android:navigationBarColor">#292928</item>
</style>
<style name="CarbonAppTheme" parent="DarkAppTheme">
 <item name="android:colorAccent">#BCBCBC</item>
 <item name="android:colorControlNormal">#A5A5A5</item>
 <item name="android:colorControlActivated">#DEDEDE</item>
 <item name="android:windowBackground">#222222</item>
 <item name="android:statusBarColor">#222222</item>
 <item name="android:navigationBarColor">#222222</item>
</style>
</resources>
